# ==============================================================
# PrepStreak AI — Environment Configuration Template
# Duplicate this file to .env.local and populate your secrets.
# DO NOT COMMIT SENSITIVE SECRETS OR KEYS TO VERSION CONTROL.
# ==============================================================

# 1. NEXT.JS ENVIRONMENT
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# 2. SUPABASE AUTH & DATABASE CONFIGURATION
# Obtain these from your Supabase Project Settings -> API (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server-side service role key (OPTIONAL / for administrative triggers only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. GOOGLE GEMINI AI CONFIGURATION (For Axmok AI Tutor & Question Solving)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# 4. RESEND EMAIL DELIVERY CONFIGURATION (Server-Side Only - For Real OTP Email Delivery)
# Obtain your API key from Resend: https://resend.com/api-keys
# NEVER expose RESEND_API_KEY to the browser or commit to git.
RESEND_API_KEY=re_your_api_key_here
# Sender email address. Use "PrepStreak AI <onboarding@resend.dev>" for testing domain,
# or your verified domain e.g. "PrepStreak AI <noreply@yourdomain.com>".
EMAIL_FROM="PrepStreak AI <onboarding@resend.dev>"

